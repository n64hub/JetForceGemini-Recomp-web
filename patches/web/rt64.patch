+            state->rsp->loadBlockDKR(lrs);
+            state->rdp->loadBlock(tile, uls, ult, lrs, dxt);
+        }
+
+        void moveWord(State *state, DisplayList **dl) {
+            switch ((*dl)->p0(0, 8)) {
+            case 0x02:
+                state->rsp->setBillboardDKR(((*dl)->w1 & 1U) != 0);
+                break;
+            case 0x0A:
