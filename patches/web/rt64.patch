+            ((r << 3) | (r >> 2)) / 255.0f,
+            ((g << 3) | (g >> 2)) / 255.0f,
+            ((b << 3) | (b >> 2)) / 255.0f,
+            (src & 1) ? (7.0f / cvgRange) : 0.0f
+        };
+    }
