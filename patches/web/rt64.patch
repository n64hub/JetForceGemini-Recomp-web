+            }
+        }
+
+        void moveWordJFG(State *state, DisplayList **dl) {
+            if (traceJFG()) {
+                fprintf(stderr, "[JFG-GFX] MW  w0=%08X w1=%08X\n", (*dl)->w0, (*dl)->w1);
