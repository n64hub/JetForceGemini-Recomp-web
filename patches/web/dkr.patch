 // Images the launcher shows, registered under the names its RML uses ("/jfg_vibintoast" -> "jfg_vibintoast").
 static bool queue_launcher_image(const char* name, const char* file) {
+#ifdef __EMSCRIPTEN__
+    // A page's files are in the page's thread's file system, and every read from another thread waits for that
+    // thread: an istreambuf_iterator reads the 4 MB VibinToast image a KB at a time, thousands of round trips as the
+    // launcher starts. So it is read in 4 MB pieces.
+    const int in = open(dino::runtime::get_asset_path(file).c_str(), O_RDONLY);
+    struct stat st;
+    if (in < 0 || fstat(in, &st) != 0) {
+        if (in >= 0) close(in);
+        return false;
+    }
+    std::vector<char> bytes(st.st_size);
+    size_t done = 0;
+    while (done < bytes.size()) {
+        const ssize_t got = read(in, bytes.data() + done, std::min<size_t>(bytes.size() - done, 4 << 20));
+        if (got <= 0) break;
+        done += got;
+    }
+    close(in);
+    bytes.resize(done);
+#else
     std::ifstream in(dino::runtime::get_asset_path(file), std::ios::binary);
     if (!in) return false;
     std::vector<char> bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+#endif
     if (bytes.empty()) return false;
     recompui::queue_image_from_bytes_file(name, bytes);
     return true;
