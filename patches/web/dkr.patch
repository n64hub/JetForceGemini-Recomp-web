     find_package(SDL2 REQUIRED)
 
@@ -325,10 +376,20 @@ target_link_libraries(JetForceGeminiRecompiled PRIVATE
     rt64
     RmlUi::Core
     RmlUi::Debugger
-    nfd
     lunasvg
 )
 
+if (EMSCRIPTEN)
+    # The page (lib/N64Recomp-browser/frontend), with the menus' assets and the controller mappings in its .data file.
+    # No ROM: the player picks theirs in the launcher, and it stays in the browser.
+    n64recomp_browser_frontend_page(JetForceGeminiRecompiled)
+    target_link_options(JetForceGeminiRecompiled PRIVATE
+        "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/assets@/assets"
+        "SHELL:--preload-file ${RECOMP_CONTROLLER_DB_TXT}@/recompcontrollerdb.txt")
+else()
+    target_link_libraries(JetForceGeminiRecompiled PRIVATE nfd)
+endif()
+
 if (${WIN32})
     add_compile_definitions(NOMINMAX)
 endif()
@@ -356,7 +417,9 @@ else()
             set(SPIRVCROSS "DYLD_LIBRARY_PATH=${PROJECT_SOURCE_DIR}/lib/rt64/src/contrib/spirv-cross/lib/arm64" "${PROJECT_SOURCE_DIR}/lib/rt64//src/contrib/spirv-cross/bin/x64/spirv-cross")
         endif()
     else()
-        if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|AMD64")
