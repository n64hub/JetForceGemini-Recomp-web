+                break;
+            default:
+                GBI_F3D::moveWord(state, dl);
+                break;
+            }
+        }
+
+        void reset(State *state) {
+            GBI_F3D::reset(state);
+            // DKR is an 8 MB N64 title. Recompiled game pointers can retain
+            // KSEG0/KSEG1 bits, which must wrap through the RSP DMA mask
