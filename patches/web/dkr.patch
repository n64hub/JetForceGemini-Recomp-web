 endif()
 
+# With Emscripten (emcmake cmake), the game builds as a page for a browser, JetForceGeminiRecompiled.html, through
+# lib/N64Recomp-browser/frontend: RT64 and the menus on WebGPU, mods off. tools/build_web.sh patches the libraries and
+# builds it (BUILDING.md, "The web page").
+if (EMSCRIPTEN)
+    # Every library static. Below, set(BUILD_SHARED_LIBS OFF) loses to lunasvg's option(BUILD_SHARED_LIBS ... ON) on a
+    # build dir's first configure (policy CMP0077's old behaviour), and a shared lunasvg makes Emscripten link the page
+    # relocatable, which wasm-ld refuses for an EM_JS function whose address is taken ("recompile with -fPIC").
+    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+    # This project is cloned into the fork's web-build/, beside its lib/N64Recomp-browser.
+    set(N64RECOMP_BROWSER_DIR "${CMAKE_SOURCE_DIR}/../lib/N64Recomp-browser" CACHE PATH "N64Recomp-browser's checkout")
+    # Threads are pthreads (SharedArrayBuffer), and the runtime ends a game thread by throwing. -msimd128 is wasm SIMD,
+    # which every browser with WebGPU has, and -mtail-call makes the recompiled code's tail calls return_calls.
+    add_compile_options(-pthread -fwasm-exceptions -msimd128 -mtail-call)
+    # With -msimd128 xxHash would take its NEON path through Emscripten's arm_neon.h, which doesn't compile in C++
+    # there. XXH_HAS_INCLUDE is used for nothing else, so XXH3 stays scalar.
+    add_compile_options("-DXXH_HAS_INCLUDE(x)=0")
+    add_link_options(-pthread -fwasm-exceptions)
+    # ccache when it is on PATH (BUILDING.md, "The web page").
+    include(${N64RECOMP_BROWSER_DIR}/frontend/build_speed.cmake)
+    # The shaders the page builds before the game starts (src/rt64_shaders.txt says how they were recorded).
+    if (EXISTS ${CMAKE_SOURCE_DIR}/src/rt64_shaders.txt)
+        set(RT64_PREBUILT_SHADER_LIST ${CMAKE_SOURCE_DIR}/src/rt64_shaders.txt)
+    endif()
+endif()
+
 # Avoid warning about DOWNLOAD_EXTRACT_TIMESTAMP in CMake 3.24:
 if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.24.0")
     cmake_policy(SET CMP0135 NEW)
@@ -58,11 +83,24 @@ add_subdirectory(${CMAKE_SOURCE_DIR}/lib/lunasvg)
 # set(BUILD_SHARED_LIBS "${BUILD_SHARED_LIBS_SAVED}")
 SET(RMLUI_SVG_PLUGIN ON CACHE BOOL "" FORCE)
 SET(RMLUI_TESTS_ENABLED OFF CACHE BOOL "" FORCE)
+if (EMSCRIPTEN)
+    # RmlUi's FreeType is Emscripten's port, in the build of it whose setjmp matches -fwasm-exceptions; the plain
+    # build's setjmp needs JavaScript exceptions. tools/build_web.sh builds it with "embuilder build freetype-legacysjlj".
+    set(FREETYPE_LIBRARY "${EMSCRIPTEN_SYSROOT}/lib/wasm32-emscripten/libfreetype-legacysjlj.a" CACHE FILEPATH "")
+endif()
