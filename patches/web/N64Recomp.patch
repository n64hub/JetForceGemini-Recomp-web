+// A list of function names, one per line; # starts a comment. Exits on a missing file or a name listed twice.
+std::vector<std::string> read_func_name_list(const std::filesystem::path& filename) {
+    std::ifstream input_file{ filename };
+    if (!input_file.good()) {
+        fmt::print(stderr, "Failed to read function list {}\n", filename.string());
+        std::exit(EXIT_FAILURE);
+    }
+
+    std::vector<std::string> names{};
+    std::unordered_set<std::string> seen{};
+    std::string line;
+    while (std::getline(input_file, line)) {
+        line = line.substr(0, line.find('#'));
+        size_t start = line.find_first_not_of(" \t\r");
+        if (start == std::string::npos) {
+            continue;
+        }
+        std::string name = line.substr(start, line.find_last_not_of(" \t\r") + 1 - start);
+        if (!seen.insert(name).second) {
+            fmt::print(stderr, "Function {} is listed twice in {}\n", name, filename.string());
+            std::exit(EXIT_FAILURE);
+        }
+        names.emplace_back(std::move(name));
+    }
+    return names;
+}
